# dependencies
node_modules/
.pnp
.pnp.js

# env / secrets
.env
.env.local
*.local

# build output
dist/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# benchmark run outputs (keep the dir, ignore the runs)
results/*.json
results/*.jsonl
results/adversary/*.json
!results/.gitkeep
!results/adversary/.gitkeep

# fine-tuning artifacts (models are multi-GB; the script + runbook are tracked)
training/outputs/
training/*-lora/
training/*-gguf/
training/out/
training/*.gguf
training/Modelfile
training/gold.jsonl

# logs & misc
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# generated Ollama modelfiles (local artifacts)
training/Modelfile.adapter
training/Modelfile.local

# anclaje humano: la clave de desciframiento no se sube hasta terminar de calificar
# (se regenera igual con `node anclaje-humano/generar_hoja.mjs`, semilla fija)
anclaje-humano/clave/

# second-family judge: raw caches and re-judged runs stay local (same rule as results/*.json)
results/juez-segunda-familia/cache-*.jsonl
results/juez-segunda-familia/rejuzgado-*.json
