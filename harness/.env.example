# Llaves de los proveedores frontier (deja en blanco las que no uses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama corre local; cambia solo si tu host/puerto es distinto
OLLAMA_HOST=http://localhost:11434

# Modelos por defecto al usar un alias sin versión (provider:model evita esto).
# IDs verificados vía búsqueda web (jun 2026):
#   OpenAI:    gpt-5.5  (snapshot estable: gpt-5.5-2026-04-23)
#   Anthropic: claude-opus-4-8  (lanzado 28 may 2026)
#   Google:    gemini-3.5-flash (GA desde 19 may 2026; gemini-2.x flash se retiró el 1 jun 2026)
DEFAULT_OPENAI_MODEL=gpt-5.5
DEFAULT_ANTHROPIC_MODEL=claude-opus-4-8
DEFAULT_GEMINI_MODEL=gemini-3.5-flash
